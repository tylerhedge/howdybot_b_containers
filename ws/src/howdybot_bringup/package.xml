<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>howdybot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files for HowdyBot. Placeholder node proves the container pipeline works.</description>
  <maintainer email="tylerhedge@tamu.edu">HowdyBot team</maintainer>
  <license>MIT</license>

  <!-- rosdep reads these to decide what to install in the images.
       Add sensor drivers here as exec_depends once hardware is chosen, e.g.
       <exec_depend>realsense2_camera</exec_depend>
       <exec_depend>usb_cam</exec_depend> -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
